<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LuSplit.App.Features.Auth.AuthenticationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Sign In">

    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">

        <Image
            Source="logo.png"
            HeightRequest="80"
            HorizontalOptions="Center" />

        <Label
            Text="LuSplit"
            FontSize="Title"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center" />

        <Label
            Text="Keep your groups in sync across all your devices. You can also share groups with friends — everything stays private and encrypted."
            FontSize="Body"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center" />

        <ActivityIndicator
            IsRunning="{Binding IsSigningIn}"
            IsVisible="{Binding IsSigningIn}"
            HorizontalOptions="Center" />

        <Label
            Text="{Binding ErrorMessage}"
            TextColor="Red"
            IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyToBoolConverter}}"
            HorizontalTextAlignment="Center" />

        <Button
            Text="Sign In"
            Command="{Binding SignInCommand}"
            IsEnabled="{Binding IsSigningIn, Converter={StaticResource InvertedBoolConverter}}"
            IsVisible="{Binding IsAuthenticated, Converter={StaticResource InvertedBoolConverter}}"
            HorizontalOptions="Fill" />

        <!-- Signed-in user info panel -->
        <VerticalStackLayout
            IsVisible="{Binding IsAuthenticated}"
            Spacing="4"
            HorizontalOptions="Fill">
            <Label
                Text="Signed in"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />
            <Label
                Text="{Binding DisplayName}"
                IsVisible="{Binding DisplayName, Converter={StaticResource StringNotNullOrEmptyToBoolConverter}}"
                HorizontalTextAlignment="Center" />
            <Label
                Text="{Binding Username}"
                TextColor="{StaticResource TextMutedGray}"
                FontSize="Small"
                HorizontalTextAlignment="Center" />
            <Label
                Text="{Binding UserId}"
                TextColor="{StaticResource TextMutedGray}"
                FontSize="Small"
                HorizontalTextAlignment="Center" />
            <Button
                Text="Sign Out"
                Command="{Binding SignOutCommand}"
                HorizontalOptions="Fill"
                Margin="0,8,0,0" />
        </VerticalStackLayout>

    </VerticalStackLayout>

</ContentPage>
