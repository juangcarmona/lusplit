<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LuSplit.App.Features.SharedGroups.ShareGroupPage"
             Title="Share this group">

    <VerticalStackLayout Padding="24" Spacing="16">

        <!-- Already shared state -->
        <VerticalStackLayout IsVisible="{Binding IsAlreadyShared}" Spacing="12">
            <Label Text="This group is already shared."
                   HorizontalTextAlignment="Center"
                   FontAttributes="Bold" />
            <Label Text="You can invite people or manage members from the group details page."
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource TextMutedGray}" />
            <Button Text="Go to group details"
                    Clicked="OnGoToGroupDetailsClicked"
                    AutomationId="GoToGroupDetailsButton"
                    HorizontalOptions="Fill" />
        </VerticalStackLayout>

        <!-- Convert flow -->
        <VerticalStackLayout IsVisible="{Binding IsConvertMode}" Spacing="12">
            <Label
                Text="Turn this group into a shared group to sync it across your devices or invite friends to split expenses together."
                HorizontalTextAlignment="Center"
                TextColor="{StaticResource TextMutedGray}" />

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}" />

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyToBoolConverter}}"
                   TextColor="Red" />

            <Button Text="Share this group"
                    Command="{Binding CreateSharedGroupCommand}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
        </VerticalStackLayout>

        <!-- Create new shared group flow -->
        <VerticalStackLayout IsVisible="{Binding IsCreateMode}" Spacing="12">
            <Label
                Text="Create a new shared group to split expenses with friends."
                HorizontalTextAlignment="Center"
                TextColor="{StaticResource TextMutedGray}" />

            <Label Text="Currency" />
            <Entry Text="{Binding Currency}" Placeholder="EUR" />

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}" />

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyToBoolConverter}}"
                   TextColor="Red" />

            <Button Text="Start Sharing"
                    Command="{Binding CreateSharedGroupCommand}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
        </VerticalStackLayout>

    </VerticalStackLayout>

</ContentPage>
