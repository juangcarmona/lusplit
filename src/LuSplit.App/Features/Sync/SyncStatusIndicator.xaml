<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LuSplit.App.Features.Sync.SyncStatusIndicator">
    <HorizontalStackLayout Spacing="4"
                           IsVisible="{Binding ShowSyncIndicator}">
        <Label Text="{Binding StatusIconGlyph}"
               FontFamily="FARegular"
               FontSize="12"
               VerticalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
        <Label Text="{Binding StatusText}"
               FontSize="11"
               VerticalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
    </HorizontalStackLayout>
</ContentView>
